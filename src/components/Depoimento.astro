---
import Icon from "./Icon.astro";

// Depoimentos reais, transcritos dos prints em Feedbacks/
const destaque = {
  texto:
    "A forma como vocês ensinam, incentivam, corrigem e conduzem a prática faz toda a diferença no aprendizado e na confiança que a gente sai para atuar na vida real. Em nenhum momento foi apenas “mais um curso”.",
  nome: "Lorena Holanda",
  contexto: "Aluna do ACLS · Cáceres/MT",
};
const outros = [
  {
    texto:
      "Melhor experiência que já tive em treinamento. Após o curso, com certeza, vou ter muito mais bagagem e segurança pra enfrentar um plantão.",
    nome: "Danilo",
    contexto: "Aluno do ACLS · Cáceres/MT",
  },
  {
    texto: "Foi ótimo!! Obrigada, Diego e Laura. Super indico!!!",
    nome: "Dra. Lara Rosa",
    contexto: "Aluna do ACLS · Turma UFU",
  },
];
const iniciais = (n: string) =>
  n
    .replace(/^Dra?\.\s*/, "")
    .split(" ")
    .map((p) => p[0])
    .slice(0, 2)
    .join("");
---
<section id="depoimentos" class="section relative overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute top-1/2 left-1/2 h-[28rem] w-[56rem] max-w-full -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/25 blur-[140px]"></div>
  </div>

  <div class="container-x relative">
    <figure class="mx-auto max-w-4xl text-center" data-reveal>
      <Icon name="quote" class="mx-auto size-20 text-accent/30 sm:size-28" />
      <blockquote class="mt-4 text-2xl leading-snug font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl">
        “{destaque.texto}”
      </blockquote>
      <figcaption class="mt-10 flex items-center justify-center gap-4">
        <span class="inline-flex size-14 items-center justify-center rounded-full bg-gradient-to-br from-brand to-accent text-lg font-bold ring-2 ring-accent/50 ring-offset-4 ring-offset-ink">
          {iniciais(destaque.nome)}
        </span>
        <span class="text-left">
          <span class="block font-semibold">{destaque.nome}</span>
          <span class="block text-sm text-muted">{destaque.contexto}</span>
        </span>
      </figcaption>
    </figure>

    <div class="mx-auto mt-16 grid max-w-4xl gap-5 md:grid-cols-2">
      {outros.map((d, i) => (
        <figure class="glass rounded-2xl p-6" data-reveal style={`--reveal-delay:${i * 100}ms`}>
          <blockquote class="leading-relaxed text-fg/90">“{d.texto}”</blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <span class="inline-flex size-10 items-center justify-center rounded-full bg-accent/20 text-sm font-bold text-accent-soft">
              {iniciais(d.nome)}
            </span>
            <span>
              <span class="block text-sm font-semibold">{d.nome}</span>
              <span class="block text-xs text-muted">{d.contexto}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
