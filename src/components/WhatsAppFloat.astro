---
import { site } from "../config/site";
import Icon from "./Icon.astro";
const external = site.whatsappUrl.startsWith("http");
---
<a
  href={site.whatsappUrl}
  data-cta="whatsapp"
  data-pos="flutuante"
  aria-label="Falar com o ITS no WhatsApp"
  class="fixed right-4 bottom-4 z-40 inline-flex size-14 items-center justify-center rounded-full bg-emerald-500 text-white shadow-lg shadow-emerald-500/30 transition-transform hover:scale-110 sm:right-6 sm:bottom-6"
  {...(external ? { target: "_blank", rel: "noopener" } : {})}
>
  <Icon name="whatsapp" class="size-7" />
</a>
