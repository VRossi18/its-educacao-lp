---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

interface Props {
  id: string;
  titulo: string;
  imagens: { src: ImageMetadata; alt: string }[];
  formato: "foto" | "print";
}
const { id, titulo, imagens, formato } = Astro.props;
const full = await Promise.all(imagens.map((i) => getImage({ src: i.src, width: 1280, format: "webp" })));
const item =
  formato === "print"
    ? "w-[64vw] sm:w-[16rem] lg:w-[17rem] aspect-[9/19]"
    : "w-[82vw] sm:w-[24rem] lg:w-[26rem] aspect-[4/3]";
---
<div class="carrossel" data-carrossel>
  <div class="container-x flex items-center justify-between gap-4">
    <h3 class="text-xl font-bold tracking-tight sm:text-2xl">{titulo}</h3>
    <div class="flex gap-2">
      <button
        type="button"
        data-prev
        aria-controls={id}
        aria-label={`Anterior: ${titulo}`}
        class="inline-flex size-12 items-center justify-center rounded-full border border-line bg-white/5 transition-colors hover:border-accent/50 hover:bg-accent/15 disabled:opacity-30"
      >
        <Icon name="chevron-left" />
      </button>
      <button
        type="button"
        data-next
        aria-controls={id}
        aria-label={`Próximo: ${titulo}`}
        class="inline-flex size-12 items-center justify-center rounded-full border border-line bg-white/5 transition-colors hover:border-accent/50 hover:bg-accent/15 disabled:opacity-30"
      >
        <Icon name="chevron-right" />
      </button>
    </div>
  </div>

  <ul
    id={id}
    data-track
    aria-label={titulo}
    class="no-scrollbar mt-6 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth scroll-px-4 px-4 pb-6 sm:scroll-px-6 sm:px-6 lg:scroll-px-[max(2rem,calc((100vw-80rem)/2+2rem))] lg:px-[max(2rem,calc((100vw-80rem)/2+2rem))]"
  >
    {imagens.map((img, i) => (
      <li class={`group relative shrink-0 snap-center overflow-hidden rounded-2xl border border-line bg-navy shadow-xl shadow-black/40 ${item}`}>
        <button type="button" data-zoom data-full={full[i].src} class="block size-full cursor-zoom-in" aria-label={`Ampliar: ${img.alt}`}>
          <Image
            src={img.src}
            alt={img.alt}
            widths={formato === "print" ? [300, 560] : [420, 840]}
            sizes={formato === "print" ? "(min-width: 640px) 272px, 64vw" : "(min-width: 640px) 416px, 82vw"}
            class="size-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
        </button>
      </li>
    ))}
  </ul>
</div>
