---
import { Image, Picture } from "astro:assets";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { instrutores } from "../data/instrutores";
---
<section id="instrutores" class="section relative overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute top-1/3 -left-40 h-[30rem] w-[30rem] rounded-full bg-brand/20 blur-[140px]"></div>

  <div class="container-x relative">
    <div class="flex flex-col gap-8" data-reveal>
      <div>
        <p class="pill">Conheça seus instrutores</p>
        <h2 class="mt-5 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
          Aprenda com quem vive a emergência na prática.
        </h2>
      </div>

      <div role="tablist" aria-label="Instrutores" class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0">
        {instrutores.map((ins, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${ins.id}`}
            aria-controls={`panel-${ins.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            class="flex min-h-12 shrink-0 items-center gap-3 rounded-full border border-line bg-white/[0.03] py-1.5 pr-5 pl-1.5 text-sm font-medium text-muted transition-all hover:border-accent/40 hover:text-fg aria-selected:border-accent/60 aria-selected:bg-accent/15 aria-selected:text-fg aria-selected:shadow-glow"
          >
            <Image src={ins.foto} alt="" width={80} height={80} class="size-9 rounded-full object-cover object-top" />
            {ins.nome}
          </button>
        ))}
      </div>
    </div>

    {instrutores.map((ins, i) => (
      <div
        role="tabpanel"
        id={`panel-${ins.id}`}
        aria-labelledby={`tab-${ins.id}`}
        hidden={i !== 0}
        class="mt-12 grid grid-cols-1 items-start gap-12 lg:grid-cols-12"
      >
        <!-- Coluna esquerda: card de perfil fixo -->
        <div class="lg:sticky lg:top-28 lg:col-span-5">
          <div class="group relative overflow-hidden rounded-3xl border border-blue-500/30 shadow-2xl transition-all duration-500 hover:border-blue-500/60 hover:shadow-glow">
            <Picture
              src={ins.foto}
              formats={["avif", "webp"]}
              widths={[400, 600, 800]}
              sizes="(min-width: 1024px) 38vw, 100vw"
              alt={`Retrato de ${ins.nome}`}
              class="aspect-[4/5] w-full object-cover object-top saturate-[0.85] transition-transform duration-700 group-hover:scale-105"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-ink/10 to-transparent"></div>
            <div class="pointer-events-none absolute inset-0 bg-brand/10 mix-blend-soft-light"></div>
            <p class="glass absolute top-4 left-4 rounded-full px-3.5 py-1.5 text-xs font-semibold text-fg">
              <span class="text-accent-soft">✦</span> {ins.badge}
            </p>
            <div class="absolute right-5 bottom-5 left-5">
              <p class="text-xl font-bold tracking-tight">{ins.nome}</p>
              <p class="mt-1 text-sm text-muted">{ins.nome.startsWith("Dra.") ? "Instrutora" : "Instrutor"} AHA &amp; HSI</p>
            </div>
          </div>
        </div>

        <!-- Coluna direita: narrativa de credibilidade -->
        <div class="lg:col-span-7">
          <h3 class="text-3xl font-bold tracking-tight sm:text-4xl">{ins.nome}</h3>
          <p class="mt-2 text-lg text-accent-soft">{ins.cargo}</p>

          <dl class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
            {ins.metricas.map((m) => (
              <div class="rounded-2xl border border-line bg-navy/70 p-5">
                <dt class="text-xs tracking-wider text-muted uppercase">{m.rotulo}</dt>
                <dd class="mt-2 text-2xl font-bold text-blue-400 sm:text-3xl">{m.valor}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-8 space-y-5 text-lg leading-relaxed text-muted">
            {ins.bio.map((p) => <p>{p}</p>)}
          </div>

          <blockquote class="relative mt-8 overflow-hidden rounded-2xl border border-accent/25 bg-gradient-to-br from-brand/20 to-transparent p-6 sm:p-8">
            <Icon name="quote" class="absolute -top-2 right-4 size-20 text-accent/15" />
            <p class="relative text-lg leading-relaxed font-medium text-fg sm:text-xl">
              No ITS, ensinamos com excelência técnica, formamos com responsabilidade e treinamos para agir com precisão.
            </p>
            <footer class="relative mt-3 text-sm text-muted">Filosofia de ensino do ITS</footer>
          </blockquote>

          <p class="mt-8 text-lg leading-relaxed text-muted">
            Sem enrolação: você aprende os algoritmos, pratica em manequins e simuladores e recebe feedback individual
            até executar com segurança.
          </p>

          <div class="mt-10 border-t border-line pt-6">
            <p class="text-xs tracking-wider text-muted uppercase">Programas e formação</p>
            <ul class="mt-4 flex flex-wrap items-center gap-x-8 gap-y-3">
              {ins.selos.map((s) => (
                <li class="text-xl font-bold tracking-tight text-fg/40 grayscale transition-colors hover:text-fg/80">{s}</li>
              ))}
            </ul>
          </div>

          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <Button cta="inscricao" pos={`instrutor-${ins.id}`}>Quero treinar com o ITS</Button>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#instrutores [role="tab"]'));
  const select = (tab: HTMLButtonElement, focus = false) => {
    for (const t of tabs) {
      const active = t === tab;
      t.setAttribute("aria-selected", String(active));
      t.tabIndex = active ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !active;
    }
    if (focus) tab.focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (e) => {
      const dir = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      select(tabs[(i + dir + tabs.length) % tabs.length], true);
    });
  });
</script>
